{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_hash",
    "decision_reason",
    "items"
  ],
  "properties": {
    "snapshot_hash": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64
    },
    "decision_reason": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S"
    },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "action_id",
          "candidate_action_ids",
          "sources",
          "reason",
          "action",
          "review_change",
          "offer_group_id",
          "new_offer_key",
          "preference_basis"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "create",
              "link",
              "update",
              "review",
              "ignore"
            ]
          },
          "action_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "candidate_action_ids": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 256
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "source_hash"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "maxLength": 256,
                  "minLength": 1
                },
                "source_hash": {
                  "type": "string",
                  "maxLength": 64,
                  "minLength": 1
                }
              }
            }
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "\\S"
          },
          "action": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "title",
              "description",
              "start",
              "end",
              "all_day",
              "temporal_kind",
              "due_at",
              "activity_scope",
              "optional"
            ],
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 250,
                "minLength": 1
              },
              "description": {
                "type": "string",
                "maxLength": 3000
              },
              "start": {
                "type": "string",
                "maxLength": 40
              },
              "end": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 40
              },
              "all_day": {
                "type": "boolean"
              },
              "temporal_kind": {
                "type": "string",
                "enum": [
                  "event",
                  "deadline",
                  "reminder"
                ]
              },
              "due_at": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 40
              },
              "activity_scope": {
                "type": "string",
                "enum": [
                  "school",
                  "extracurricular",
                  "unknown"
                ]
              },
              "optional": {
                "type": "boolean"
              }
            }
          },
          "review_change": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "create",
              "update",
              "cancel",
              null
            ]
          },
          "offer_group_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "new_offer_key": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "preference_basis": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "outcome",
              "example_ids"
            ],
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "accept",
                  "reject",
                  "uncertain"
                ]
              },
              "example_ids": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            }
          }
        }
      }
    }
  }
}
