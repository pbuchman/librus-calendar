    "decision",
    "action_id",
    "evidence_id",
    "source_quote",
    "candidate_quote",
    "anchors",
    "reason"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "match",
        "distinct",
        "uncertain"
      ]
    },
    "action_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "evidence_id": {
      "type": ["string", "null"],
      "maxLength": 160
    },
    "source_quote": {
      "type": "string",
      "maxLength": 4000
    },
    "candidate_quote": {
      "type": "string",
      "maxLength": 4000
    },
    "anchors": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "reason": {
      "type": "string",
      "maxLength": 1000
    }
  }
}
