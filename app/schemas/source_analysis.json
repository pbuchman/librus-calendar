{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposals",
    "decision_reason"
  ],
  "properties": {
    "proposals": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "title",
          "description",
          "start",
          "end",
          "all_day",
          "confidence",
          "needs_review",
          "review_reason",
          "source_quote",
          "event_id",
          "temporal_kind",
          "due_at",
          "activity_scope",
          "alternative_group",
          "alternative_group_evidence",
          "recipient",
          "optional",
          "date_certainty",
          "action_identity",
          "informational",
          "offer_identity"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "cancel",
              "ignore"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 250
          },
          "description": {
            "type": "string",
            "maxLength": 3000
          },
          "start": {
            "type": "string",
            "maxLength": 40
          },
          "end": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "all_day": {
            "type": "boolean"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "needs_review": {
            "type": "boolean"
          },
          "review_reason": {
            "type": "string",
            "maxLength": 1000
          },
          "source_quote": {
            "type": "string",
            "maxLength": 4000
          },
          "event_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "temporal_kind": {
            "type": "string",
            "enum": [
              "event",
              "deadline",
              "reminder"
            ]
          },
          "due_at": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "activity_scope": {
            "type": "string",
            "enum": [
              "school",
              "extracurricular",
              "unknown"
            ]
          },
          "alternative_group": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "alternative_group_evidence": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4000
          },
          "recipient": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "learner_id",
              "class_id",
              "evidence",
              "condition"
            ],
            "properties": {
              "scope": {
                "type": "string",
                "enum": [
                  "learner",
                  "class",
                  "all",
                  "other",
                  "conditional",
                  "unknown"
                ]
              },
              "learner_id": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 160
              },
              "class_id": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 160
              },
              "evidence": {
                "type": "string",
                "maxLength": 4000
              },
              "condition": {
                "type": "string",
                "enum": [
                  "none",
                  "role",
                  "participation",
                  "unknown"
                ]
              }
            }
          },
          "optional": {
            "type": "boolean"
          },
          "informational": {
            "type": "boolean"
          },
          "date_certainty": {
            "type": "string",
            "enum": [
              "explicit",
              "inferred",
              "uncertain",
              "undated"
            ]
          },
          "action_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action_type",
              "object",
              "occasion",
              "evidence"
            ],
            "properties": {
              "action_type": {
                "type": "string",
                "enum": [
                  "attend",
                  "bring",
                  "submit",
                  "pay",
                  "prepare",
                  "collect",
                  "inform",
                  "other"
                ]
              },
              "object": {
                "type": "string",
                "maxLength": 300
              },
              "occasion": {
                "type": "string",
                "maxLength": 300
              },
              "evidence": {
                "type": "string",
                "maxLength": 4000
              }
            }
          },
          "offer_identity": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "label",
              "evidence"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 300
              },
              "evidence": {
                "type": "string",
                "maxLength": 4000
              }
            }
          }
        }
      }
    },
    "decision_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    }
  }
}
