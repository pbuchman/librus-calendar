# Managed by librus-calendar deployment v1
[Unit]
Description=Check Librus and synchronize school dates
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/lib/librus-calendar/current
ExecStart=%h/.local/lib/librus-calendar/current/.venv/bin/python -I -m app.cli sync
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
